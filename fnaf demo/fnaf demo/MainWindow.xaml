                     Text="00:00" 
                     VerticalAlignment="Top"
                     Width="68" RenderTransformOrigin="0.5,0.5" Background="#00000000" FontSize="20" Foreground="White" BorderBrush="Black" FontFamily="Dubai" IsReadOnly="True">
